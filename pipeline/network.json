{
 "collectors": [
  {
   "id": "mlb_probables",
   "sport": "mlb",
   "kind": "probables",
   "verified": true,
   "note": "Probable starting pitchers (names). ERA comes from ESPN in the main pipeline.",
   "url": "https://statsapi.mlb.com/api/v1/schedule?sportId=1&date={date}&hydrate=probablePitcher",
   "dayOffsets": [
    0,
    1
   ],
   "items": "dates[].games[]",
   "required": [
    "home",
    "away"
   ],
   "fields": {
    "home": "teams.home.team.name",
    "away": "teams.away.team.name",
    "start": "gameDate",
    "homePitcher": "teams.home.probablePitcher.fullName",
    "awayPitcher": "teams.away.probablePitcher.fullName"
   }
  },
  {
   "id": "nhl_schedule",
   "sport": "nhl",
   "kind": "schedule",
   "verified": false,
   "note": "Field names inside the team objects are a guess until the first live run.",
   "url": "https://api-web.nhle.com/v1/schedule/{date}",
   "dayOffsets": [
    0
   ],
   "items": "gameWeek[].games[]",
   "required": [
    "id",
    "start"
   ],
   "fields": {
    "id": "id",
    "start": "startTimeUTC",
    "home": "homeTeam.abbrev",
    "away": "awayTeam.abbrev",
    "state": "gameState"
   }
  },
  {
   "id": "nba_scoreboard",
   "sport": "nba",
   "kind": "schedule",
   "verified": false,
   "url": "https://cdn.nba.com/static/json/liveData/scoreboard/todaysScoreboard_00.json",
   "items": "scoreboard.games[]",
   "required": [
    "id",
    "home",
    "away"
   ],
   "fields": {
    "id": "gameId",
    "start": "gameTimeUTC",
    "home": "homeTeam.teamName",
    "away": "awayTeam.teamName",
    "status": "gameStatusText"
   },
   "enabled": false,
   "note": "cdn.nba.com returned 403 Forbidden from GitHub Actions; disabled. NBA games come from ESPN instead."
  },
  {
   "id": "nfl_injuries",
   "sport": "nfl",
   "kind": "injuries",
   "verified": false,
   "format": "csv",
   "note": "nflverse release asset names are a guess until the first live run.",
   "url": "https://github.com/nflverse/nflverse-data/releases/download/injuries/injuries_{season}.csv",
   "required": [
    "team",
    "player"
   ],
   "fields": {
    "team": "team",
    "player": "full_name",
    "position": "position",
    "status": "report_status",
    "week": "week"
   }
  },
  {
   "id": "soccer_fixtures",
   "sport": "epl",
   "kind": "schedule",
   "verified": false,
   "format": "csv",
   "note": "football-data.co.uk fixtures list (all covered leagues, one file).",
   "url": "https://www.football-data.co.uk/fixtures.csv",
   "required": [
    "home",
    "away"
   ],
   "fields": {
    "league": "Div",
    "date": "Date",
    "home": "HomeTeam",
    "away": "AwayTeam"
   }
  }
 ]
}